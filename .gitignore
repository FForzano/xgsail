# Data files (too large for git)
data/
train-data/
!scripts/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
# setuptools build dir, written by `pip install ./libs/xgsail_windfusion` (CI and Docker test runs)
libs/xgsail_windfusion/build/
.eggs/
*.egg
venv/
.venv/
.env
.env.*
!.env.example
!.env.native.example
.pytest_cache

# Node.js
node_modules/
dist/
*.tgz

# Capacitor native projects (generated by `cap add ios`/`cap add android`)
# and their build output — checked in only after real signing/entitlement
# config is added by hand; see docs/native-apps.md.
frontend/ios/App/Pods/
frontend/ios/App/build/
frontend/android/.gradle/
frontend/android/app/build/
frontend/android/build/
frontend/android/local.properties

# Android release signing — never commit
frontend/android/*.keystore
frontend/android/*.jks
frontend/android/keystore.properties

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
.VSCodeCounter

# Logs
*.log

# Temporary files
*.tmp

# Secrets — never commit
.aws/
credentials.json
secrets/
*.secret
*.secret.json
secrets.json

# Claude Code
.claude/
!.claude/commands
!.claude/commands/*

# Media
*.mp4

# Impeccable: PRODUCT.md, DESIGN.md, the shared config, design sidecar, surface
# briefs and critique snapshots are versioned; per-developer settings, hook
# caches, run logs, live-mode sessions and regenerable mocks/screenshots are not.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/questions/
.impeccable/review/
.impeccable/mocks/
.impeccable/build/
.impeccable/live/sessions/
