# Dev-only frontend container: runs the Vite dev server with hot reload
# against source mounted from the host (see docker-compose.override.yml),
# instead of building a static bundle into nginx like the production
# Dockerfile. Never used for deploy.
FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host"]
