# SailFrames environment variables.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit
# real secrets. These drive docker-compose.yml (the self-hosted stack).

# --- MinIO (S3-compatible blob storage) ---
# Root credentials; also handed to the API + workers as AWS_* creds.
MINIO_ROOT_USER=sailframes
MINIO_ROOT_PASSWORD=change-me-long-secret

# --- Object storage ---
SAILFRAMES_BUCKET=sailframes-fleet-data-prod
SAILFRAMES_DATA_PREFIX=processed
AWS_DEFAULT_REGION=us-east-1

# --- Track thumbnails (workers/process_upload/thumbnail.py) ---
# Tile template ({z}/{x}/{y}) for the OSM raster background composited under
# track previews; empty string disables it (transparent track-only PNG).
THUMBNAIL_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Sent on every tile request — OSM's tile usage policy requires a descriptive one.
THUMBNAIL_TILE_USER_AGENT=XGSail/1.0 track thumbnail renderer (+https://github.com/FForzano/xgsail)

# --- OTA updates (native app, see ota-service/ + docs/ota-updates.md) ---
# Key prefix within SAILFRAMES_BUCKET for the OTA manifest + bundles.
SAILFRAMES_OTA_PREFIX=app-updates

# Shared secret gating the MinIO -> /hooks/minio ingest webhook.
SAILFRAMES_HOOK_TOKEN=change-me-random-token

# --- Postgres (metadata) ---
# The compose file wires POSTGRES_HOST/PORT to the `postgres` service; only the
# credentials below are read from .env. backend/db builds the SQLAlchemy URL
# from these discrete vars (no password embedded in a single DATABASE_URL token).
POSTGRES_USER=sailframes
POSTGRES_PASSWORD=change-me-long-secret
POSTGRES_DB=sailframes

# --- Overpass cache / map data ---
# User-Agent used for the server-side Overpass requests. Keep it descriptive so
# public mirrors can contact the maintainer if a quota or abuse issue arises.
# Use a compact, RFC-safe format without shell-ambiguous characters.
OVERPASS_USER_AGENT="XGSail/1.0 (mailto:f.forzano@ieee.org)"
# Overpass instances to try, in order, comma- or space-separated. Unset uses
# the built-in defaults (overpass-api.de, then overpass.private.coffee). This
# is here so a failing or rate-limiting instance can be swapped without
# editing and redeploying code — which is what this list used to require, and
# how it once ended up misconfigured badly enough that no request was sent at
# all. A value that is not a list of absolute http(s) URLs fails at startup
# rather than degrading quietly.
# OVERPASS_ENDPOINTS="https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter"

# --- Auth ---
# Secret for signing HS256 access JWTs (required for native login).
SAILFRAMES_JWT_SECRET=change-me-random-jwt-secret
# Optional first superadmin, seeded on startup.
SAILFRAMES_SUPERADMIN_EMAIL=
SAILFRAMES_SUPERADMIN_PASSWORD=

# --- Production only (deploy/docker-compose.prod.yml) ---
# Set to "1" once served over HTTPS (via the Cloudflare Tunnel below) so
# auth cookies get the Secure flag; leave "0"/unset for local dev over http.
SAILFRAMES_COOKIE_SECURE=0
# Browser-reachable MinIO address for presigned upload/download URLs —
# the second Cloudflare Tunnel public hostname below, e.g.
# https://minio.xgsail.com. See the comment on this var in
# docker-compose.yml for what happens if it's left unset.
SAILFRAMES_S3_PUBLIC_ENDPOINT=https://minio.xgsail.com
# Explicit CORS allow-list (CSV) — defaults to Vite-dev-only origins, which
# breaks anything cross-origin in production. The web SPA is same-origin
# (no CORS involved), but the native app's WebView calls api.xgsail.com
# directly and IS subject to CORS (it's still a fetch() in a browser
# engine, not a fully native HTTP client) — its origins must be listed here.
# server.hostname in frontend/capacitor.config.ts (app.xgsail.com — a
# dedicated, purely virtual hostname that doesn't need to exist in DNS, so
# password managers recognize the native app via base-domain matching
# instead of "localhost") sets the WebView's virtual origin on BOTH
# platforms with Capacitor 8: capacitor://app.xgsail.com on iOS,
# https://app.xgsail.com on Android (androidScheme: "https" in the config).
# capacitor://localhost/https://localhost are kept as fallbacks for builds
# without the hostname override (e.g. before it was introduced, or an older
# Capacitor major where iOS ignored server.hostname and always used
# capacitor://localhost).
SAILFRAMES_CORS_ORIGINS=capacitor://localhost,https://localhost,capacitor://app.xgsail.com,https://app.xgsail.com
# Token for the Cloudflare Tunnel. Created in the Cloudflare Zero Trust
# dashboard (Networks > Tunnels); not needed for local dev. One tunnel
# routes every public hostname (configured in the dashboard, not here —
# see deploy/README.md for the full table):
#   xgsail.com       -> http://frontend:80
#   minio.xgsail.com -> http://minio:9000
#   api.xgsail.com   -> http://backend:8000   (native apps, bypasses nginx)
#   ota.xgsail.com   -> http://ota-service:8081
CLOUDFLARE_TUNNEL_TOKEN=
